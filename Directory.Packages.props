<Project>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />

    <!-- ASP.NET Core / EF Core (.NET 10 line) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />

    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />

    <!-- Messaging / storage (used from M2) -->
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- SqlClient pulls 9.0.11 (GHSA-846f-f764-76mx); the shared framework of .NET 10 already ships a patched one, so pin it for projects that restore the package -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="StandardWebhooks" Version="1.0.36" />
  </ItemGroup>
</Project>
